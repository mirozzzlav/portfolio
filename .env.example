# Domain shared by the public URL and contact email addresses; no protocol or path.
DOMAIN_NAME=mirofurinda.com

# HTTP port bound to the host loopback interface.
HTTP_PORT=8080

# Canonical URL used when prerendering HTML and generating the sitemap.
SITE_URL=https://${DOMAIN_NAME}

# Shared settings for local development, production builds, Docker, and the API.
# Public key embedded in the frontend at build time; leave empty to disable Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Contact API settings. Values without the VITE_ prefix stay on the server.
CONTACT_TO_EMAIL=info@${DOMAIN_NAME}
CONTACT_FROM_EMAIL="Portfolio <noreply@${DOMAIN_NAME}>"
CONTACT_ALLOWED_ORIGINS=${SITE_URL},http://localhost:${HTTP_PORT}
MAIL_DRY_RUN=true
TURNSTILE_SECRET_KEY=

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
